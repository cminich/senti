# Copy to .env.local for local work, and set the same values in your Vercel
# project settings. Restart the dev server after changing anything here.

# Credentials for the Vercel AI Gateway, which routes the read to a model.
# Create a key at https://vercel.com/dashboard/ai-gateway/api-keys
AI_GATEWAY_API_KEY=

# Which model reads the conversation. Any ID the gateway exposes works; see
# https://ai-gateway.vercel.sh/v1/models
SENTI_MODEL=openai/gpt-5-mini

# Shared class code. Students enter this once to reach the app, and the model
# endpoint refuses to run without it.
#
# Leaving this blank is fine locally, where the app stays open for convenience.
# In production a blank value fails closed: the deployment shows a setup notice
# instead of letting anyone with the URL spend your credits.
SENTI_PASSCODE=
